{
	"name": "repro-kit-cloudflare-workers-protocol",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"evidence": "rg -n \"cloudflare:workers\" .svelte-kit/output/server || true"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260928.1",
		"@sveltejs/adapter-cloudflare": "8.0.0-next.8",
		"@sveltejs/kit": "3.0.0-next.31",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "5.9.3",
		"vite": "8.3.1",
		"wrangler": "4.142.0"
	}
}
